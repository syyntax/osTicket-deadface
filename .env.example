# Copy this file to .env and fill in real values before running
# `docker-compose up`. .env is gitignored - never commit real secrets.

# --- Database ---
DB_NAME=osticket
DB_USER=osticket
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme-root
DB_TABLE_PREFIX=ost_

# --- osTicket site settings (used only on first boot, to run the installer) ---
OSTICKET_SITE_NAME=DEADFACE CTF Support
OSTICKET_DEFAULT_EMAIL=support@deadface.io
OSTICKET_LANG=en_US
OSTICKET_TIMEZONE=America/Chicago

# --- Initial Staff admin account (Staff Control Panel login) ---
OSTICKET_ADMIN_FNAME=Jason
OSTICKET_ADMIN_LNAME=Scott
OSTICKET_ADMIN_EMAIL=admin@deadface.io
OSTICKET_ADMIN_USERNAME=dctf-admin
OSTICKET_ADMIN_PASSWORD=changeme

# --- Outbound email via SendGrid Web API (DigitalOcean blocks SMTP) ---
# Sender addresses (support@, alerts@, noreply@ your domain) must be a
# verified Sender Identity or an authenticated domain in SendGrid.
SENDGRID_API_KEY=

# --- Local access (standalone, pre-rev-proxy) ---
APP_HTTP_PORT=8080
